{
  "color": {
    "$type": "color",
    "base": {
      "indigo": {
        "100": {
          "$value": "#e8eafd"
        },
        "600": {
          "$value": "#3b45c4"
        },
        "700": {
          "$value": "#2f379e"
        }
      },
      "green": {
        "100": {
          "$value": "#e3f5ea"
        },
        "700": {
          "$value": "#1d7a45"
        }
      },
      "amber": {
        "100": {
          "$value": "#fdf3dc"
        },
        "700": {
          "$value": "#8a5a00"
        }
      },
      "red": {
        "100": {
          "$value": "#fde8e8"
        },
        "700": {
          "$value": "#b42318"
        }
      },
      "gray": {
        "50": {
          "$value": "#f7f8fa"
        },
        "200": {
          "$value": "#dde1e7"
        },
        "600": {
          "$value": "#5b6472"
        },
        "900": {
          "$value": "#1a1f29"
        }
      },
      "white": {
        "$value": "#ffffff"
      }
    },
    "fg": {
      "default": {
        "$value": "{color.base.gray.900}"
      },
      "muted": {
        "$value": "{color.base.gray.600}"
      },
      "onAccent": {
        "$value": "{color.base.white}"
      },
      "accent": {
        "$value": "{color.base.indigo.600}"
      },
      "success": {
        "$value": "{color.base.green.700}"
      },
      "attention": {
        "$value": "{color.base.amber.700}"
      },
      "critical": {
        "$value": "{color.base.red.700}"
      }
    },
    "bg": {
      "default": {
        "$value": "{color.base.white}"
      },
      "subtle": {
        "$value": "{color.base.gray.50}"
      },
      "accent": {
        "$value": "{color.base.indigo.600}"
      },
      "accentHover": {
        "$value": "{color.base.indigo.700}"
      },
      "accentSubtle": {
        "$value": "{color.base.indigo.100}"
      },
      "success": {
        "$value": "{color.base.green.100}"
      },
      "attention": {
        "$value": "{color.base.amber.100}"
      },
      "critical": {
        "$value": "{color.base.red.100}"
      }
    },
    "border": {
      "default": {
        "$value": "{color.base.gray.200}"
      }
    }
  },
  "space": {
    "1": {
      "$value": "4px"
    },
    "2": {
      "$value": "8px"
    },
    "3": {
      "$value": "12px"
    },
    "4": {
      "$value": "16px"
    },
    "6": {
      "$value": "24px"
    },
    "8": {
      "$value": "32px"
    },
    "12": {
      "$value": "48px"
    },
    "$type": "dimension"
  },
  "radius": {
    "$type": "dimension",
    "small": {
      "$value": "4px"
    },
    "medium": {
      "$value": "8px"
    },
    "large": {
      "$value": "16px"
    },
    "full": {
      "$value": "9999px"
    }
  },
  "font": {
    "size": {
      "$type": "dimension",
      "small": {
        "$value": "0.875rem"
      },
      "body": {
        "$value": "1rem"
      },
      "large": {
        "$value": "1.25rem"
      },
      "title": {
        "$value": "1.75rem"
      }
    }
  }
}
